# Auto detect text files and perform LF normalization
* text=auto

# Code and configuration files with LF normalization
*.py text eol=lf
*.m text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows command and script files require CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Preserved model artifacts & weights (strictly CRLF to match frozen SHA-256)
experiments/**/models/*.json text eol=crlf

# Binary artifacts (no line ending transformation)
*.slx binary
*.slxc binary
*.mat binary
*.npz binary
*.pkl binary
*.db binary
*.sqlite binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary

# Git LFS tracking for large dataset archives
data/ieee9bus_60hz_phase5c/processed/phase5c_waveforms_20k.npz filter=lfs diff=lfs merge=lfs -text
