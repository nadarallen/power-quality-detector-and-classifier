# ==============================================================================
# IEEE 9-Bus Power Quality Detector and Classifier — Environment Configuration
# Copy this file to .env and adjust variables as required for your local machine.
# ==============================================================================

# Backend Server Configuration
PQD_SERVER_HOST=127.0.0.1
PQD_SERVER_PORT=8500
PQD_TELEMETRY_PORT=8502

# MATLAB Environment Configuration (Optional - auto-detected if on system PATH)
# Example Windows: C:\Program Files\MATLAB\R2025a\bin\matlab.exe
# Example Linux:   /usr/local/MATLAB/R2025a/bin/matlab
MATLAB_EXECUTABLE=matlab

# Presentation and Simulation Defaults
PQD_DEFAULT_MODE=live
PQD_DEFAULT_DURATION_S=5.0
PQD_SAMPLE_RATE_HZ=5000.0
PQD_NOMINAL_FREQ_HZ=60.0

# Telemetry and Storage
PQD_DATABASE_PATH=data/pq_events.db
PQD_ENABLE_AUDIT_LOGGING=true
