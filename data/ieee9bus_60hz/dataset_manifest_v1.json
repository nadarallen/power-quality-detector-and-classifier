      "h2_ratio": "Ratio of H2 magnitude to H1",
      "h3_ratio": "Ratio of H3 magnitude to H1",
      "h4_ratio": "Ratio of H4 magnitude to H1",
      "h5_ratio": "Ratio of H5 magnitude to H1",
      "h7_ratio": "Ratio of H7 magnitude to H1",
      "h9_ratio": "Ratio of H9 magnitude to H1",
      "h11_ratio": "Ratio of H11 magnitude to H1",
      "harmonic_energy": "Sum of squared higher harmonic magnitudes H2..H11",
